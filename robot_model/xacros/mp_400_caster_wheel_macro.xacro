<?xml version="1.0"?>
<!--
Author: Pradheep Padmanabhan
Contributor: Adarsh Karan K P
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mp_400">

  <!--Caster Wheel Macro-->
  <xacro:macro name="mp_400_caster_wheel" params="
    wheel_prefix
    wheel_joint_type
    *origin
    parent_link
    ">

    <joint name="${wheel_prefix}_joint" type="${wheel_joint_type}">
      <xacro:insert_block name="origin"/>
      <axis xyz="-1 0 0"/>
      <dynamics damping="10" friction="100"/>
      <parent link="${parent_link}"/>
      <child link="${wheel_prefix}_link"/>
    </joint>

    <link name="${wheel_prefix}_link">
      <inertial>
        <mass value="1.4"/>
        <inertia 
          ixx="0.00499743171" 
          ixy="0.00000004464" 
          ixz="-0.00000002245" 
          iyy="0.00499741733" 
          iyz="-0.00000000164" 
          izz="0.00839239692"
          />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 3.14"/>
        <geometry>
          <mesh filename="package://neo_mp_400-2/robot_model/meshes/MP-400-CASTER-WHEEL.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 3.14"/>
        <geometry>
          <sphere radius="0.038"/>                
        </geometry>
      </collision>
    </link>
      
  </xacro:macro>

</robot>
