<?xml version="1.0"?>
<!--
Author: Pradheep Padmanabhan
Contributor: Adarsh Karan K P
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mp_400">

  <!-- Import wheel macros -->
  <xacro:include filename="$(find neo_mp_400-2)/robot_model/xacros/mp_400_wheel_macro.xacro"/>
  <xacro:include filename="$(find neo_mp_400-2)/robot_model/xacros/mp_400_caster_wheel_macro.xacro"/>

  <xacro:macro name="mp_400_body">
      
    <!-- Robot Base-->
    <link name="base_link"/>
    
    <link name="base_footprint">
      <inertial>
        <mass value="30"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1.71402" ixy="0.0" ixz="0.0" iyy="0.8856" iyz="0.0" izz="2.5725"/>
      </inertial>
      <visual>
        <origin rpy="0 0 1.570796" xyz="0.0 0.0 0"/>
        <geometry>
          <mesh filename="package://neo_mp_400-2/robot_model/meshes/MP-400-BODY.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy=" 0 0. 1.570796" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://neo_mp_400-2/robot_model/meshes/MP-400-BODY.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <joint name="base_footprint_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <axis xyz="0 0 -1"/>
      <parent link="base_link"/>
      <child link="base_footprint"/>
    </joint>

    <!-- Caster Wheel-->
    <xacro:mp_400_caster_wheel 
      wheel_prefix="mp_400_caster_wheel_front_left"
      parent_link="base_link" 
      wheel_joint_type="fixed"
      >
      <origin rpy="0 0 -1.57" xyz="0.165 0.155 0.036"/>
    </xacro:mp_400_caster_wheel>

    <xacro:mp_400_caster_wheel 
      wheel_prefix="mp_400_caster_wheel_back_left"
      parent_link="base_link" 
      wheel_joint_type="fixed"
      >
      <origin rpy="0 0 -1.57" xyz="-0.220 0.155 0.036"/>
    </xacro:mp_400_caster_wheel>

    <xacro:mp_400_caster_wheel 
      wheel_prefix="mp_400_caster_wheel_front_right"
      parent_link="base_link" 
      wheel_joint_type="fixed"
      >
      <origin rpy="0 0 -1.57" xyz="0.165 -0.155 0.036"/>
    </xacro:mp_400_caster_wheel>

    <xacro:mp_400_caster_wheel 
      wheel_prefix="mp_400_caster_wheel_back_right"
      parent_link="base_link" 
      wheel_joint_type="fixed"
      >
      <origin rpy="0 0 -1.57" xyz="-0.220 -0.155 0.036"/>
    </xacro:mp_400_caster_wheel>

    <!-- Wheels-->
    <xacro:mp_400_fixed_wheel 
      wheel_prefix="mp_400_fixed_wheel_right"
      parent_link="base_link" 
      wheel_joint_type="revolute"
      visual_origin_rpy="0 0 3.14"
      >
      <origin rpy="0 0 -1.57" xyz="0. -${wheel_separation/2} 0.074"/>
    </xacro:mp_400_fixed_wheel>

    <xacro:mp_400_fixed_wheel 
      wheel_prefix="mp_400_fixed_wheel_left"
      parent_link="base_link" 
      wheel_joint_type="revolute"
      visual_origin_rpy="0 0 0"
      >
      <origin rpy="0 0 -1.57" xyz="-0. ${wheel_separation/2} 0.074"/>
    </xacro:mp_400_fixed_wheel>

  </xacro:macro>

</robot>
