<?xml version="1.0"?>
<!--
Author: Pradheep Padmanabhan
Contributor: Adarsh Karan K P
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mp_400">
<!-- This is the main URDF file for mp_400-->

  <!-- Xacro Arguments-->
  <xacro:arg name="use_gz" default="false"/>
  <xacro:arg name="use_imu" default="false"/>
  <xacro:arg name="use_d435" default="false"/>
  <xacro:arg name="use_uss" default="false"/>
  <xacro:arg name="scanner_type" default="sick_s300"/>

  <!-- Xacro Properties -->
  <xacro:property name="gz" value="$(arg use_gz)"/>
  <xacro:property name="imu" value="$(arg use_imu)"/>
  <xacro:property name="d435" value="$(arg use_d435)"/>
  <xacro:property name="uss" value="$(arg use_uss)"/>
  <xacro:property name="scanner" value="$(arg scanner_type)"/>
  <xacro:property name="scanner_height" value="0"/>
  <xacro:property name="wheel_separation" value="0.529"/>

  <!-- Include the robot body -->
  <xacro:include filename="$(find neo_mp_400-2)/robot_model/xacros/mp_400_body.urdf.xacro"/>
    <xacro:mp_400_body/>

  <!-- Laser Scanners -->
  <xacro:if value="${scanner == 'sick_s300'}">
    <!--https://neobotix-docs.de/hardware/en/platforms/mp-400/mechanical.html-->
    <xacro:property name="scanner_height" value="0.110"/>
    <xacro:include filename="$(find neo_mp_400-2)/robot_model/xacros/sick_s300_macro.xacro"/>
  </xacro:if>

  <xacro:if value="${scanner == 'sick_microscan3'}">
    <xacro:property name="scanner_height" value="0.110"/>
    <xacro:include filename="$(find neo_mp_400-2)/robot_model/xacros/sick_microscan3_macro.xacro"/>
  </xacro:if>
  
  <xacro:sick_laser_scanner 
    name="lidar_1" 
    parent="base_link"
    >
    <origin rpy="0 3.14 3.14" xyz="0.230 0 ${scanner_height}"/>
  </xacro:sick_laser_scanner>

  <!-- Realsense D435 -->
  <xacro:if value="${d435 == True}">
    <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>
    <xacro:sensor_d435 
      parent="base_link"
      >
      <origin xyz="0.292 0.0 0.716" rpy="0 0 0"/>
    </xacro:sensor_d435>
  </xacro:if>
  
  <!-- Using IMU -->
  <xacro:if value="${imu == True}">
    <link name="imu_link">
      <inertial>
        <mass value="0.001" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.0001" />
      </inertial>  
    </link>
    <joint name="imu_joint" type="fixed">
      <axis xyz="0 1 0"/>
      <origin rpy="0 0 0" xyz="0.250 -0.090 0.1525"/>
      <parent link="base_link"/>
      <child link="imu_link"/>
    </joint>
  </xacro:if>

  <!--Ultrasonic Sensors-->
  <xacro:if value="${uss == True}">
    <xacro:include filename="$(find neo_mp_400-2)/robot_model/xacros/uss.xacro" />
  <!-- Comment or uncomment based on your requirement -->
    <!-- SENSOR 1 -->
    <xacro:us_sensor name="us_1" parent="base_link">
      <origin xyz="-0.266 0.157 0.280" rpy="0 0 2.617" />
    </xacro:us_sensor>
    <!-- SENSOR 1 -->
    <xacro:us_sensor name="us_2" parent="base_link">
      <origin xyz="-0.298 0 0.280" rpy="0 0 3.14" />
    </xacro:us_sensor>
    <!-- SENSOR 1 -->
    <xacro:us_sensor name="us_3" parent="base_link">
      <origin xyz="-0.266 -0.157 0.280" rpy="0 0 3.665"/>
    </xacro:us_sensor>
    <!-- SENSOR 1 -->
    <xacro:us_sensor name="us_9" parent="base_link">
      <origin xyz="0.266 0.157 0.280" rpy="0 0 0.523" />
    </xacro:us_sensor>
      <!-- SENSOR 1 -->
    <xacro:us_sensor name="us_10" parent="base_link">
      <origin xyz="0.298 0 0.280" rpy="0 0 0" />
    </xacro:us_sensor>
    <!-- SENSOR 1 -->
    <xacro:us_sensor name="us_11" parent="base_link">
      <origin xyz="0.266 -0.157 0.280" rpy="0 0 5.759" />
    </xacro:us_sensor>
  </xacro:if>

  <!-- Simulation -->
  <xacro:if value="${gz == True}">
    <xacro:include filename="$(find mp_components)/urdf/gazebo/mp_400/mp_400_gazebo.urdf.xacro" />
    <xacro:mp_400_gazebo />
  </xacro:if>
    
</robot>

